{
  "name": "tourflow-front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TourFlow — SPA турфирмы: бронирование номеров, кабинет клиента, управление отелями",
  "scripts": {
    "start": "webpack serve --config webpack/webpack.dev.cjs",
    "start:mock": "VITE_MOCK=1 webpack serve --config webpack/webpack.dev.cjs",
    "build": "webpack --config webpack/webpack.prod.cjs",
    "build:analyze": "ANALYZE=1 webpack --config webpack/webpack.prod.cjs",
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "build:vite": "vite build",
    "build:pages": "VITE_MOCK=1 VITE_BASE=/tourflow-front/ vite build && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "effector": "^23.5.2",
    "effector-react": "^23.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "mini-css-extract-plugin": "^2.9.1",
    "msw": "^2.15.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "webpack": "^5.95.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0",
    "webpack-merge": "^6.0.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,html,yml}": "prettier --write"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "last 2 versions",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  }
}
